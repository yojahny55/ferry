pkgname=ferry-fm
pkgver=0.3.1
pkgrel=1
pkgdesc='A keyboard-first file manager that follows the Omarchy theme'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'wayland' 'fontconfig' 'glib2' 'xdg-utils' 'coreutils' 'libarchive')
optdepends=('xdg-terminal-exec: Open Terminal Here')
makedepends=('cargo')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/ferry "$pkgdir/usr/bin/ferry"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/ferry.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ferry.svg"
  install -Dm644 "$startdir/ferry.desktop" "$pkgdir/usr/share/applications/ferry.desktop"
  install -Dm644 "$startdir/ferry-file-manager1.service" "$pkgdir/usr/share/dbus-1/services/ferry-file-manager1.service"
}
